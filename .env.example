# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Where magic-link emails send people back to.
# Local: http://localhost:3000 — Production: https://YOUR_DOMAIN
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without it, "Estimate with AI" is hidden and everything else works.
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional. Only these email addresses may sign in. Comma-separated.
ALLOWED_EMAILS=you@example.com
